# 复制为 .env 后填写（勿提交真实 key）

LLM_PROVIDER=custom

# 方案 B：网关根地址，程序会拼 /v1/chat/completions；此时优先读 ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=http://your-one-api-host
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_MODEL=glm-5.1

# 方案 A（可选）：显式 URL，若设置则覆盖 ANTHROPIC_BASE_URL
# LLM_API_URL=https://host/.../chat/completions
# LLM_API_KEY=sk-xxx

LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_MS=400
LLM_RPM=0
LLM_STREAM_TIMEOUT_SECONDS=600
