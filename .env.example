LLM_PROVIDER=custom

# 网关根地址，程序会拼 /v1/chat/completions；此时优先读 ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=http://your-one-api-host
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_MODEL=glm-5.1

# ---------- 企业认证----------
# AUTH_ENABLED=true
# JWT_SECRET=至少32字符随机串
# AUTH_USERS=alice:密码:acme:admin;bob:密码2:acme:user
# AUTH_ALLOW_ANONYMOUS_DEBUG=false
# 刷新令牌存储：默认自动探测 MySQL（root@127.0.0.1:3306/my_cursor），不可用则降级内存。
# 显式指定 DSN 覆盖默认值；写 "memory" 强制走内存（仅单实例开发）。
# AUTH_REFRESH_MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/my_cursor?parseTime=true&loc=Local&charset=utf8mb4
# JWT_ACCESS_TTL_MINUTES=15
# JWT_REFRESH_TTL_HOURS=168

# ---------- GitHub OAuth（个人 5 分钟可申请）----------
# 申请：https://github.com/settings/developers → New OAuth App
#   Homepage URL 填 my_cursor 主页（开发期可填 http://127.0.0.1:8089/）
#   Authorization callback URL 必须与 GITHUB_REDIRECT_URI 完全一致
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://127.0.0.1:8089/api/auth/oauth/github/callback
# 绑定 login 或 numeric id -> 租户:角色（多条用英文分号）
# OAUTH_GITHUB_BINDINGS=your_github_login:default:admin
# 或允许任意 GitHub 用户自动落到 default 租户的 user 角色
# GITHUB_OAUTH_AUTO=true
# GITHUB_OAUTH_DEFAULT_TENANT=default
# GITHUB_OAUTH_DEFAULT_ROLES=user

# OAuth 登录成功后回到前端的根地址（不写则用根 "/"）
# OAUTH_AFTER_LOGIN_REDIRECT=http://127.0.0.1:8089/

# ---------- 微信开放平台 · 网站应用扫码登录----------
# 需在开放平台创建「网站应用」，授权回调域与 WECHAT_REDIRECT_URI 一致（不含 fragment）。
 WECHAT_OPEN_APP_ID=
# WECHAT_OPEN_APP_SECRET=
# WECHAT_REDIRECT_URI=http://127.0.0.1:8089/api/auth/oauth/wechat/callback
# WECHAT_AFTER_LOGIN_REDIRECT=http://127.0.0.1:8089/
# 绑定 unionid/openid -> 租户:角色 ; OAUTH_WECHAT_BINDINGS=oXXX:acme:user,admin
# 或 WECHAT_OAUTH_AUTO=true + WECHAT_OAUTH_DEFAULT_TENANT=default + WECHAT_OAUTH_DEFAULT_ROLES=user

LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_MS=400
LLM_RPM=0
LLM_STREAM_TIMEOUT_SECONDS=600
